+/* FP16 range guard for the converted-weight GEMM path. Weights are scaled by
+ * 2^-SHIFT during the in-place conversion and activations by 2^-SHIFT at the
+ * graph's input cast, so the F16 matmul product is true/2^(2*SHIFT); the
+ * BF16-cast output is rescaled by 2^(2*SHIFT). Power-of-two scaling only
+ * touches exponents, so within range it costs zero mantissa precision; what
+ * it buys is 2^(2*SHIFT) headroom over FP16's 65504 max for the outputs (and
+ * 2^SHIFT for the inputs), which is what turned overflow-NaN black frames
+ * into a working path. */
+#define H3_GPU_F16_SCALE_SHIFT 3u
+
+/* Rewrite a BF16 tensor's buffer as FP16 in place (exact within FP16 range;
+ * saturations are counted). The tensor keeps dtype BF16 for the streaming
+ * machinery -- f16Contents records what the bits mean now. Any consumer that
+ * honours the flag must read the buffer as FP16; a fresh upload clears it. */
+int h3_gpu_tensor_convert_bf16_f16(h3_gpu *opaque, h3_gpu_tensor *tensor) {
+    H3GPU *gpu = GPU(opaque);
+    if (!gpu || !tensor) return 0;
+    H3Tensor *object = TENSOR(tensor);
+    if (object.dtype != H3_GPU_BF16 || object.elements > UINT32_MAX) {
+        h3_gpu_set_error(gpu, @"BF16->FP16 conversion needs a BF16 tensor "
+                         @"with a 32-bit element count");
+        return 0;
+    }
+    if (object.f16Contents) return 1;
+    if (!gpu.f16SaturationBuffer) {
+        gpu.f16SaturationBuffer = [gpu.device
+            newBufferWithLength:sizeof(uint32_t)
+                        options:MTLResourceStorageModeShared];
+        if (!gpu.f16SaturationBuffer) {
+            h3_gpu_set_error(gpu, @"cannot allocate FP16 saturation counter");
+            return 0;
+        }
+        memset(gpu.f16SaturationBuffer.contents, 0, sizeof(uint32_t));
+    }
+    uint32_t elements = (uint32_t)object.elements;
+    id<MTLBuffer> counter = gpu.f16SaturationBuffer;
+    float scale = 1.0f / (float)(1u << H3_GPU_F16_SCALE_SHIFT);
+    if (!h3_gpu_dispatch_1d(gpu, @"h3_bf16_to_f16_inplace", elements,

+            [encoder setBuffer:object.buffer offset:0 atIndex:0];
+            [encoder setBuffer:counter offset:0 atIndex:1];
+            [encoder setBytes:&elements length:sizeof(elements) atIndex:2];
+            [encoder setBytes:&scale length:sizeof(scale) atIndex:3];
+        })) return 0;

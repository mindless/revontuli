+ * and flips the bits here after each block's upload. */
+kernel void h3_bf16_to_f16_inplace(device ushort *data [[buffer(0)]],
+                                   device atomic_uint *saturated [[buffer(1)]],
+                                   constant uint &elements [[buffer(2)]],
+                                   constant float &scale [[buffer(3)]],
+                                   uint gid [[thread_position_in_grid]]) {
+    if (gid >= elements) return;

+/* End-of-denoise housekeeping shared by the CPU and GPU Euler paths. The
+ * final submit drained the queue, so the slot fences are all retired; holding
+ * them across generations would pin their command buffers (and every resource
+ * those encoded) for the life of a cached session. */
+static void denoise_finish(h3_dit *dit) {
+    for (unsigned slot = 0; slot < H3_STREAM_SLOTS; slot++) {
+        h3_gpu_fence_release(dit->stream_fences[slot]);
+        dit->stream_fences[slot] = NULL;
+    }
+    if (dit->fp16_gemm && getenv("H3_PROFILE")) {
+        uint64_t saturated = h3_gpu_f16_saturation(dit->gpu);
+        fprintf(stderr, "h3: FP16 GEMM weight conversions saturated %llu "
+                "value(s)%s\n", (unsigned long long)saturated,
+                saturated ? "  <-- FP16 clipped real weights, inspect output"
+                          : "");
+    }
+}

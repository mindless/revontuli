+/* Pipelined block boundary: commit the current chain WITHOUT draining the
+ * queue, open a fresh buffer, and hand back a fence for the committed one.
+ * The queue is in-order, so the fence's completion covers everything
+ * committed before it. Wait-free the fence from any thread; release drops it
+ * without waiting. Both accept NULL. */
+typedef struct h3_gpu_fence h3_gpu_fence;
+int h3_gpu_submit_boundary(h3_gpu *gpu, h3_gpu_fence **fence_out);
+int h3_gpu_fence_wait_free(h3_gpu_fence *fence);
+void h3_gpu_fence_release(h3_gpu_fence *fence);
+
+/* Rewrite a BF16 tensor's buffer as IEEE FP16 in place (encoded on the
+ * current command chain). Exact within FP16 range; saturations to +-HALF_MAX
+ * are counted and readable via h3_gpu_f16_saturation. A fresh upload or host
+ * write restores BF16 meaning. h3_gpu_linear_bf16 detects converted weights
+ * and takes the FP16 matmul path automatically. */
+int h3_gpu_tensor_convert_bf16_f16(h3_gpu *gpu, h3_gpu_tensor *tensor);
+uint64_t h3_gpu_f16_saturation(const h3_gpu *gpu);
+/* BF16 in/out linear computed in FP32 (both operands cast up in-graph): the
+ * outlier-safe fast route for weights left in BF16 under H3_FP16_GEMM. */

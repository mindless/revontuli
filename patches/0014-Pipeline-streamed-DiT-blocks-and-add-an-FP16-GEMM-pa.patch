+static int h3_gpu_gaps_enabled(void) {
+    const char *value = getenv("H3_DEBUG_GPU_GAPS");
+    return value && *value && strcmp(value, "0");
+}
+
+static void h3_gpu_span_record(H3GPU *gpu, id<MTLCommandBuffer> command) {
+    if (!h3_gpu_gaps_enabled()) return;
+    if (command.GPUEndTime < command.GPUStartTime ||
+        command.GPUStartTime <= 0.0) return;
+    if (!gpu.gpuSpans) gpu.gpuSpans = [NSMutableData data];
+    double pair[2] = {command.GPUStartTime, command.GPUEndTime};
+    [gpu.gpuSpans appendBytes:pair length:sizeof(pair)];
+}
+
+static int h3_gpu_span_compare(const void *left, const void *right) {
+    const double *a = left, *b = right;
+    if (a[0] < b[0]) return -1;
+    return a[0] > b[0];
+}
+
+/* Merge the recorded spans and report true GPU busy time vs the window they
+ * cover; the difference is idle bubble time no per-buffer sum can show. */
+static void h3_gpu_spans_report(H3GPU *gpu, NSString *phase) {
+    if (!h3_gpu_gaps_enabled() || !gpu.gpuSpans.length) return;
+    size_t count = gpu.gpuSpans.length / (2 * sizeof(double));
+    double *spans = (double *)gpu.gpuSpans.mutableBytes;
+    qsort(spans, count, 2 * sizeof(double), h3_gpu_span_compare);
+    double busy = 0.0, biggest_gap = 0.0;
+    double segment_start = spans[0], segment_end = spans[1];
+    double window_end = spans[1];
+    for (size_t index = 1; index < count; index++) {
+        double start = spans[2 * index], end = spans[2 * index + 1];
+        if (end > window_end) window_end = end;
+        if (start > segment_end) {
+            busy += segment_end - segment_start;
+            if (start - segment_end > biggest_gap)
+                biggest_gap = start - segment_end;
+            segment_start = start;
+            segment_end = end;
+        } else if (end > segment_end) {
+            segment_end = end;
+        }
+    }
+    busy += segment_end - segment_start;
+    double window = window_end - spans[0];
+    fprintf(stderr,
+            "h3 gpu-gaps: %-24s buffers=%zu window=%8.3fs busy-union=%8.3fs "
+            "idle=%8.3fs biggest-gap=%.3fs\n",
+            phase.UTF8String, count, window, busy, window - busy, biggest_gap);
+    gpu.gpuSpans.length = 0;
+}

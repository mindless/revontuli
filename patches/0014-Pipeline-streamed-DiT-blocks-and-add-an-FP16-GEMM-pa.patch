+/* Commit the current command chain WITHOUT draining the queue, and hand back
+ * a fence for the just-committed buffer. This is the streamed-DiT pipelining
+ * primitive: h3_gpu_submit's waitUntilCompleted-on-everything at every block
+ * boundary left the GPU idle for the whole CPU-side encode of the next block
+ * (~0.2-0.9 s x 200 blocks per generation). A boundary keeps the queue fed;
+ * the fence lets the weight streamer wait for exactly the one block whose
+ * VRAM slot it is about to overwrite. The queue is in-order, so a fence's
+ * completion covers every buffer committed before it, including the roots
+ * MPSGraph retires via commitAndContinue. */
+int h3_gpu_submit_boundary(h3_gpu *opaque, h3_gpu_fence **fence_out) {
+    H3GPU *gpu = GPU(opaque);
+    if (fence_out) *fence_out = NULL;
+    if (!gpu || !gpu.command) return 0;
+    @autoreleasepool {
+        id<MTLCommandBuffer> command = gpu.command;
+        gpu.command = nil;
+        gpu.mpsCommand = nil;
+        double commit_time = h3_gpu_now();
+        [command commit];
+        [gpu.inflightCommands addObject:command];
+        h3_gpu_stats stats = gpu.stats;
+        stats.submissions++;
+        stats.command_encode_seconds += commit_time - gpu.commandStartWall;
+        gpu.stats = stats;
+        if (fence_out) *fence_out =
+            (h3_gpu_fence *)(__bridge_retained void *)command;
+        while (gpu.maxInflight && gpu.inflightCommands.count > gpu.maxInflight) {
+            id<MTLCommandBuffer> oldest = gpu.inflightCommands.firstObject;
+            double wait_start = h3_gpu_now();
+            [oldest waitUntilCompleted];
+            if (oldest.status == MTLCommandBufferStatusError) {
+                h3_gpu_set_error(gpu, @"Metal command failed: %@",
+                                 oldest.error.localizedDescription);
+                [gpu.inflightCommands removeAllObjects];
+                return 0;
+            }
+            stats = gpu.stats;
+            stats.command_wait_seconds += h3_gpu_now() - wait_start;
+            if (oldest.GPUEndTime >= oldest.GPUStartTime)
+                stats.gpu_seconds += oldest.GPUEndTime - oldest.GPUStartTime;
+            h3_gpu_span_record(gpu, oldest);
+            gpu.stats = stats;

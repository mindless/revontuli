+/* Group several weight uploads into one command buffer. Between begin and end,
+ * h3_gpu_tensor_stream_file_bf16 only encodes its copy; end commits and waits.
+ * No-ops on a unified-memory device, where nothing is staged. */
+void h3_gpu_upload_begin(h3_gpu *gpu);
+int h3_gpu_upload_end(h3_gpu *gpu);
+

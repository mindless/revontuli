index a71b846..e6e60ed 100644
--- a/h3_gpu.h
+++ b/h3_gpu.h
@@ -74,6 +74,12 @@ void h3_gpu_tensor_free(h3_gpu_tensor *tensor);
  * through the autorelease pool, so a C loop that allocates and releases a large

+/* Group the uploads of one streamed DiT block into a single command buffer.
+ *
+ * Measured on this eGPU: uploading each matrix in its own command buffer with
+ * commit + waitUntilCompleted achieved 0.62 GiB/s, against 1.76 GB/s that the
+ * Thunderbolt link sustains, because ~1200 uploads per generation each paid a
+ * full round trip. Four copies per block share one submission instead.
+ *
+ * Only one streaming thread is live at a time (h3_dit.c creates it and joins
+ * before the slot is consumed), so a single batch per GPU context is safe. */
+void h3_gpu_upload_begin(h3_gpu *opaque) {
+    H3GPU *gpu = GPU(opaque);
+    if (!gpu || !gpu.device || gpu.uploadBatch) return;
+    if (!gpu.uploadQueue) gpu.uploadQueue = [gpu.device newCommandQueue];
+    if (!gpu.uploadQueue) return;
+    gpu.uploadBatch = [gpu.uploadQueue commandBuffer];
+    gpu.uploadBlit = [gpu.uploadBatch blitCommandEncoder];
+    if (!gpu.uploadBlit) gpu.uploadBatch = nil;
+}
+
+int h3_gpu_upload_end(h3_gpu *opaque) {
+    H3GPU *gpu = GPU(opaque);
+    if (!gpu || !gpu.uploadBatch) return 1;
+    int ok = 1;
+    @autoreleasepool {
+        [gpu.uploadBlit endEncoding];
+        id<MTLCommandBuffer> batch = gpu.uploadBatch;
+        gpu.uploadBlit = nil;
+        gpu.uploadBatch = nil;
+        [batch commit];
+        [batch waitUntilCompleted];
+        if (batch.status == MTLCommandBufferStatusError) {
+            h3_gpu_set_error(gpu, @"batched weight upload failed: %@",
+                             batch.error.localizedDescription);
+            ok = 0;
+        }
+    }
+    return ok;
+}
+
 int h3_gpu_begin(h3_gpu *opaque) {
     H3GPU *gpu = GPU(opaque);
     if (!gpu || gpu.command || gpu.inflightCommands.count) return 0;

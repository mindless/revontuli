     unsigned char *destination = h3_tensor_host_ex(TENSOR(opaque), 0);
@@ -1037,6 +1044,7 @@ static int h3_gpu_tensor_read_file_bf16_mode(
         completed += (size_t)count;
     }
     close(descriptor);
+    double read_done = h3_gpu_now();
     if (staging) {
         H3GPU *owner = TENSOR(opaque).owner;
         if (!owner) {
@@ -1044,6 +1052,16 @@ static int h3_gpu_tensor_read_file_bf16_mode(

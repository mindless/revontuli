From c7d40ec08c3623c1791dcdc65b6c36493a6248cc Mon Sep 17 00:00:00 2001
From: Marco <mpalinar@nmblr.ai>
Date: Fri, 21 Aug 2026 12:33:00 +0800
Subject: [PATCH 06/12] Batch a streamed DiT block's four weight uploads into
 one command buffer

Each streamed matrix was uploaded in its own command buffer with commit +
waitUntilCompleted, so a generation paid roughly 1200 full round trips and the
host->VRAM path achieved 0.62 GiB/s against a link that sustains 1.76 GB/s.

h3_gpu_upload_begin/end keep one blit encoder open on a dedicated queue, so the
four matrices of a block share a single submission. Only one streaming thread is
live at a time (h3_dit.c creates it and joins before the slot is consumed), so a
single batch per GPU context is safe.

Measured at 608x352 / 22 frames / 4 steps / 50 layers:

  DiT Euler denoise wall   262.3s -> 151.2s   (1.73x)
  SSD stream aggregate     0.562  -> 1.010 GiB/s
  unhidden stream wait     124.0s ->   5.0s
  total run                364.2s -> 253.4s   (1.44x)

Output is bit-identical to the pre-optimization baseline
(md5 886b40d10c5a83fb01393a4c62bdfcbd), so this is purely scheduling.

Cumulative against the first working build: 3081.6s -> 253.4s, 12.2x.
---
 h3_dit.c |  7 ++++++
 h3_gpu.h |  6 +++++
 h3_gpu.m | 75 ++++++++++++++++++++++++++++++++++++++++++++++++++++++--
 3 files changed, 86 insertions(+), 2 deletions(-)

diff --git a/h3_dit.c b/h3_dit.c
index 4b018dc..c831c62 100644
--- a/h3_dit.c
+++ b/h3_dit.c
@@ -668,6 +668,8 @@ static int read_stream_layer(h3_dit_stream_job *job) {
     job->ok = 1;
     job->bytes = 0;
     job->error[0] = '\0';
+    /* One command buffer for all four matrices of this block. */
+    h3_gpu_upload_begin(job->dit->gpu);
     for (unsigned index = 0; index < STREAM_MATRICES; index++) {
         const h3_dit_stream_source *source = &layer->sources[index];
         h3_gpu_tensor *target = stream_slot_target(slot, source->field);
@@ -682,6 +684,11 @@ static int read_stream_layer(h3_dit_stream_job *job) {
         }
         job->bytes += (uint64_t)source->elements * sizeof(uint16_t);
     }
+    if (!h3_gpu_upload_end(job->dit->gpu) && job->ok) {
+        snprintf(job->error, sizeof(job->error), "%s",
+                 h3_gpu_error(job->dit->gpu));
+        job->ok = 0;
+    }
     job->seconds = stream_now() - started;
     return job->ok;
 }

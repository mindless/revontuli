-    if (dst.deviceLocal && dst_gpu && dst_gpu.uploadBlit &&
+    if (dst.deviceLocal && dst_gpu && t_uploadOpen &&
         getenv("H3_STREAM_MMAP") && bytes <= SIZE_MAX - (size_t)getpagesize()) {
         size_t page = (size_t)getpagesize();
         uint64_t aligned = file_offset - file_offset % page;
@@ -1061,10 +1146,7 @@ static int h3_gpu_tensor_read_file_bf16_mode(
                                  (void)p; (void)l;
                                  munmap(mapping, map_bytes);
                              }];
-            if (src) {
-                [dst_gpu.uploadBlit copyFromBuffer:src sourceOffset:0
-                                          toBuffer:dst.buffer
-                                 destinationOffset:0 size:bytes];
+            if (src && h3_gpu_upload_submit(dst_gpu, src, dst.buffer, bytes)) {
                 h3_gpu_upload_hold(src);
                 h3_gpu_stats mstats = dst_gpu.stats;
                 mstats.blit_copies++;
@@ -1113,16 +1195,9 @@ static int h3_gpu_tensor_read_file_bf16_mode(
                 snprintf(error, error_size, "streamed tensor has no owning GPU");
             return 0;
         }
-        if (owner.uploadBlit) {
-            /* A batch is open: just encode, the caller commits once. */
-            [owner.uploadBlit copyFromBuffer:staging sourceOffset:0
-                                    toBuffer:TENSOR(opaque).buffer
-                           destinationOffset:0 size:bytes];
-            h3_gpu_stats bstats = owner.stats;
-            bstats.blit_copies++;
-            owner.stats = bstats;
-            goto uploaded;
-        }
+        if (t_uploadOpen &&
+            h3_gpu_upload_submit(owner, staging, TENSOR(opaque).buffer, bytes))
+            goto uploaded;   /* committed, not waited: overlaps the next pread */
         @autoreleasepool {
             id<MTLCommandBuffer> upload = [owner.queue commandBuffer];
             id<MTLBlitCommandEncoder> blit = [upload blitCommandEncoder];
@@ -1291,66 +1366,6 @@ int h3_gpu_tensor_write_bf16_range(h3_gpu_tensor *tensor,
  *

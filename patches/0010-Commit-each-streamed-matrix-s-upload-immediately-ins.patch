+/* Weight uploads in flight, plus any mmap'd pages they reference.
+ *
+ * A block's four matrices used to share one command buffer that was committed
+ * only after all four preads had finished, so no DMA started until the last
+ * byte had been copied into staging. Committing each copy as soon as it is
+ * encoded lets the transfer of matrix i overlap the pread of matrix i+1.
+ * Measured: pread ~58 s and DMA ~92 s per generation were largely serial;
+ * overlapped, the pread hides inside the DMA.
+ *
+ * The four matrices of a block are distinct tensors with distinct staging
+ * buffers, and h3_gpu_upload_end waits before the block's slot is reused, so
+ * nothing is overwritten while a DMA reads it. Thread-local because each
+ * streaming lane owns its own set. */
+static _Thread_local void *t_uploadPending;  /* +1 retained NSMutableArray */
+static _Thread_local void *t_uploadHold;     /* +1 retained NSMutableArray */
+static _Thread_local int   t_uploadOpen;
+
+static NSMutableArray *h3_gpu_tls_array(void **slot) {
+    NSMutableArray *a = (__bridge NSMutableArray *)(*slot);
+    if (!a) { a = [NSMutableArray array]; *slot = (__bridge_retained void *)a; }
+    return a;
+}
+
+static void h3_gpu_upload_hold(id<MTLBuffer> buffer) {
+    if (buffer) [h3_gpu_tls_array(&t_uploadHold) addObject:buffer];
+}
+
+static void h3_gpu_upload_release_holds(void) {
+    NSMutableArray *hold = (__bridge_transfer NSMutableArray *)t_uploadHold;
+    t_uploadHold = NULL;
+    [hold removeAllObjects];   /* deallocators munmap here */
+}
+
+/* Encode one staging -> VRAM copy and commit it immediately, without waiting. */
+static int h3_gpu_upload_submit(H3GPU *gpu, id<MTLBuffer> source,
+                                id<MTLBuffer> destination, size_t bytes) {
+    if (!gpu || !source || !destination) return 0;
+    if (!gpu.uploadQueue) gpu.uploadQueue = [gpu.device newCommandQueue];
+    if (!gpu.uploadQueue) return 0;
+    id<MTLCommandBuffer> command = [gpu.uploadQueue commandBuffer];
+    id<MTLBlitCommandEncoder> blit = [command blitCommandEncoder];
+    if (!command || !blit) return 0;
+    [blit copyFromBuffer:source sourceOffset:0
+                toBuffer:destination destinationOffset:0 size:bytes];
+    [blit endEncoding];
+    [command commit];
+    [h3_gpu_tls_array(&t_uploadPending) addObject:command];
+    h3_gpu_stats stats = gpu.stats;
+    stats.blit_copies++;
+    gpu.stats = stats;
+    return 1;
+}
+
+void h3_gpu_upload_begin(h3_gpu *opaque) {
+    H3GPU *gpu = GPU(opaque);
+    if (!gpu || !gpu.device) return;
+    if (!gpu.uploadQueue) gpu.uploadQueue = [gpu.device newCommandQueue];
+    t_uploadOpen = 1;
+}
+
+int h3_gpu_upload_end(h3_gpu *opaque) {
+    H3GPU *gpu = GPU(opaque);
+    t_uploadOpen = 0;
+    NSMutableArray<id<MTLCommandBuffer>> *pending =
+        (__bridge_transfer NSMutableArray *)t_uploadPending;
+    t_uploadPending = NULL;
+    if (!pending.count) { h3_gpu_upload_release_holds(); return 1; }
+    int ok = 1;
+    double t0 = h3_gpu_now();
+    @autoreleasepool {
+        for (id<MTLCommandBuffer> command in pending) {
+            [command waitUntilCompleted];
+            if (command.status == MTLCommandBufferStatusError) {
+                if (gpu) h3_gpu_set_error(gpu, @"weight upload failed: %@",
+                                          command.error.localizedDescription);
+                ok = 0;
+            }
+        }
+        [pending removeAllObjects];
+        h3_gpu_upload_release_holds();
+        if (getenv("H3_DEBUG_STREAM_SPLIT")) {
+            static double t_wait; static uint64_t n;
+            t_wait += h3_gpu_now() - t0; n++;
+            if (n % 50 == 0)
+                fprintf(stderr, "h3upload: %llu batches, GPU-side transfer wait "
+                        "%.1fs total\n", (unsigned long long)n, t_wait);
+        }
+    }
+    return ok;
+}
+
 /* I close the current command buffer, keep at most maxInflight buffers
  * pending, and open a fresh one. Metal executes command buffers committed to
  * the same queue in commit order, so splitting a long chain this way does not
@@ -1044,7 +1129,7 @@ static int h3_gpu_tensor_read_file_bf16_mode(
      * the result is recorded rather than rediscovered. */
